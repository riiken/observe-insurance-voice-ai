# Copy to .env and adjust. Never commit a real .env.

# --- Application -------------------------------------------------------------
APP_NAME=observe-insurance-voice-ai
ENVIRONMENT=local            # local | dev | staging | prod
DEBUG=false
API_PREFIX=/api/v1

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console           # console for local development, json in deployment

# --- Outbound integration budget ---------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.2

# --- Voice platform (Vapi) ---------------------------------------------------
# Shared secret Vapi sends back as the `x-vapi-secret` header on every webhook.
# Set it as "Server URL Secret" on the assistant. See docs/vapi-setup.md.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional locally; the service REFUSES TO START in staging/prod without it,
# because an unauthenticated webhook is an open door to the tool layer.
VOICE_PLATFORM_API_KEY=

# Where request_representative hands the call. Leave blank if there is nowhere
# to transfer to: escalation records then say REQUESTED rather than claiming a
# transfer that did not happen, and the caller is told the truth either way.
VOICE_TRANSFER_PHONE_NUMBER=

# --- Google Sheets: Integration #1 (customer + claim retrieval) --------------
# See docs/google-sheets-setup.md. Leave blank to run without the integration:
# the service still starts and /health stays green; /ready simply reports no
# dependencies. Unit tests never read these.
#
# The spreadsheet id is the long token in the sheet URL:
#   docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=

# Tab and column ranges. Change only if you renamed the tabs.
SHEETS_CUSTOMERS_RANGE=Customers!A:D
SHEETS_CLAIMS_RANGE=Claims!A:E

# Override to point at a stub during local testing.
GOOGLE_SHEETS_BASE_URL=https://sheets.googleapis.com/v4/spreadsheets

# --- Knowledge ---------------------------------------------------------------
# Configured claim guidance (next steps + document submission instructions).
# Blank resolves to knowledge/claim_guidance.json at the repository root.
# Every claim status must be configured or the service refuses to start.
CLAIM_GUIDANCE_PATH=
# Directory of FAQ knowledge files (one Markdown file per topic).
# Blank resolves to knowledge/ at the repository root. The four required topics
# must all be present or the service refuses to start.
FAQ_DIRECTORY=
# The agent's system prompt. Blank resolves to the file shipped with the app.
SYSTEM_PROMPT_PATH=

# --- Telephony ---------------------------------------------------------------
# Applied when a caller reads a number without a country code.
DEFAULT_PHONE_COUNTRY_CODE=+1

# --- Later phases (not read yet) ---------------------------------------------
# INTERACTIONS_SHEET_ID=          # Integration #2: post-call records
