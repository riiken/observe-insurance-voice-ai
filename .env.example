# Copy to .env and adjust. Never commit a real .env.

# --- Application -------------------------------------------------------------
APP_NAME=observe-insurance-voice-ai
ENVIRONMENT=local            # local | dev | staging | prod
DEBUG=false
API_PREFIX=/api/v1

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console           # console for local development, json in deployment

# --- Outbound integration budget ---------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.2

# --- Security ----------------------------------------------------------------
# Shared secret the voice platform presents on webhook calls.
# Leave unset locally; required from staging onwards. (Enforced in Phase 2.)
VOICE_PLATFORM_API_KEY=

# --- Phase 3 placeholders (not read yet) -------------------------------------
# GOOGLE_SHEETS_CREDENTIALS_JSON=
# CUSTOMERS_SHEET_ID=
# INTERACTIONS_SHEET_ID=
