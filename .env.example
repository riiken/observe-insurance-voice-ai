# Copy to .env and adjust. Never commit a real .env.

# --- Application -------------------------------------------------------------
APP_NAME=observe-insurance-voice-ai
ENVIRONMENT=local            # local | dev | staging | prod
DEBUG=false
API_PREFIX=/api/v1

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console           # console for local development, json in deployment

# --- Outbound integration budget ---------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.2

# --- Security ----------------------------------------------------------------
# Shared secret the voice platform presents on webhook calls.
# Leave unset locally; required from staging onwards. (Enforced in a later phase.)
VOICE_PLATFORM_API_KEY=

# --- Google Sheets: Integration #1 (customer + claim retrieval) --------------
# See docs/google-sheets-setup.md. Leave blank to run without the integration:
# the service still starts and /health stays green; /ready simply reports no
# dependencies. Unit tests never read these.
#
# The spreadsheet id is the long token in the sheet URL:
#   docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_API_KEY=

# Tab and column ranges. Change only if you renamed the tabs.
SHEETS_CUSTOMERS_RANGE=Customers!A:D
SHEETS_CLAIMS_RANGE=Claims!A:E

# Override to point at a stub during local testing.
GOOGLE_SHEETS_BASE_URL=https://sheets.googleapis.com/v4/spreadsheets

# --- Telephony ---------------------------------------------------------------
# Applied when a caller reads a number without a country code.
DEFAULT_PHONE_COUNTRY_CODE=+1

# --- Later phases (not read yet) ---------------------------------------------
# INTERACTIONS_SHEET_ID=          # Integration #2: post-call records
